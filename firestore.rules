rules_version = '2';

// Application data is served by Next.js API routes. Every route verifies a
// Firebase ID token or a scoped agent token and scopes its Admin SDK operations to that user's UID.
// Direct client SDK access is disabled so writes cannot bypass audit logging
// and accounting validation in the server routes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
