{
  "name": "opentax",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "mcp:start": "node packages/opentax-mcp/dist/server.mjs",
    "mcp:build": "npm run build --workspace @opentax/mcp",
    "mcp:test": "vitest run packages/opentax-mcp",
    "source:check": "node --test scripts/ci/public-source-boundary.test.mjs && node scripts/ci/check-public-source-boundary.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.11.0",
    "firebase-admin": "^14.5.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.8.0",
    "xml2js": "^0.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/xml2js": "^0.4.14",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "@firebase/util@1.15.0": true,
    "@firebase/util@1.15.3": true,
    "fsevents": false
  }
}
